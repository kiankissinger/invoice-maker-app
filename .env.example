# RevenueCat public SDK keys (Project settings → API keys). Copy to .env.local.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Test Store key (test_…): simulated purchases with no Apple/Google account. Used in Expo Go, on the
# web, and in any build without a store key above.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# URL of the API server in server/. EAS builds get it from eas.json; set it here for `npm start`. Leave empty to run fully offline.
EXPO_PUBLIC_API_URL=https://api-production-d6d0.up.railway.app
