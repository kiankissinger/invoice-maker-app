# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoices
PUBLIC_URL=http://localhost:3000
# openssl rand -hex 32
JWT_SECRET=

# Email (https://resend.com). Without these, emails are printed to the log.
RESEND_API_KEY=
EMAIL_FROM=invoices@mail.yourdomain.com

# Stripe Connect (https://dashboard.stripe.com/connect). Without these, online payments are off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional platform fee in basis points (100 = 1%)
PLATFORM_FEE_BPS=0

# RevenueCat secret API key (v1). Without it, everyone is Pro outside production.
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=pro

# Claude API key for AI receipt scanning and line-item drafting
ANTHROPIC_API_KEY=

# Optional
APP_NAME=Invoice Maker
APP_SCHEME=invoicemaker
EXPO_ACCESS_TOKEN=
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_CODE=
JOBS_INTERVAL_MINUTES=15
AUTH_RATE_LIMIT=20
