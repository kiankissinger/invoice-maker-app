{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "test", "../src/lib/calc.ts", "../src/lib/format.ts", "../src/lib/invoice-html.ts", "../src/lib/types.ts"]
}
